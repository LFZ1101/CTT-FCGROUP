DATABASE_URL="postgresql://cct:cct_dev_password@localhost:5432/cct_intelligence?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-in-production"
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
PORT=4000

# Object storage (S3-compatible / MinIO)
STORAGE_PROVIDER="s3"
STORAGE_BUCKET="cct-documents"
STORAGE_REGION="us-east-1"
STORAGE_ENDPOINT="http://127.0.0.1:9000"
STORAGE_ACCESS_KEY="cctminio"
STORAGE_SECRET_KEY="cctminio_dev_password"
STORAGE_FORCE_PATH_STYLE="true"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
MONITOR_INTERVAL_MS="21600000"
MONITOR_CONCURRENCY="3"
DOWNLOAD_CONCURRENCY="2"
DOWNLOAD_MAX_BYTES="52428800"

# E-mail (opcional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
NOTIFY_EMAILS=""
NOTIFY_INFO="false"
NOTIFY_WEBHOOK_URL=""
NOTIFY_WEBHOOK_SECRET=""
NOTIFY_WEBHOOK_TIMEOUT_MS="8000"

# OCR (opcional — worker precisa pdftoppm + tesseract)
OCR_ENABLED="false"
OCR_LANG="por+eng"
OCR_MAX_PAGES="20"

# Observabilidade (opcional)
SENTRY_DSN=""
SENTRY_ENV="development"
SENTRY_TRACES_SAMPLE_RATE="0"
APP_VERSION="dev"

# Mediador
MEDIADOR_MODE=""
MEDIADOR_FIXTURE_PATH="fixtures/mediador/consulta-sample.html"
MEDIADOR_MAX_ATTEMPTS="3"
MEDIADOR_RETRY_MS="800"
MEDIADOR_TIMEOUT_MS="20000"
MEDIADOR_MIN_INTERVAL_MS="1500"
MEDIADOR_BLOCK_THRESHOLD="3"
MEDIADOR_COOLDOWN_MS="900000"
