# Copie estes valores no painel Netlify → Site settings → Environment variables

# URL pública da API (obrigatório em produção na Netlify)
# Ex.: https://cct-api.up.railway.app/api/v1
NEXT_PUBLIC_API_URL=https://SUA-API-AQUI/api/v1

# Opcional: usada só nos rewrites do next.config (SSR/proxy)
# API_INTERNAL_URL=https://SUA-API-AQUI
